# Copy this file to .env (which git ignores) and replace every "change-me" value:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (macOS / Linux)
# docker compose reads .env automatically. Never commit the real .env.

# ---- MySQL (created on the first start, stored in the mysql-data volume) ----
MYSQL_DATABASE=placementhub
MYSQL_USER=placementhub
MYSQL_PASSWORD=change-me-app-db-password
MYSQL_ROOT_PASSWORD=change-me-root-db-password
# Port on this computer for MySQL Workbench (inside Docker it is always 3306).
MYSQL_HOST_PORT=3307

# ---- Backend ----
# At least 32 random characters. Generate one in PowerShell with:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 48 | ForEach-Object { [char]$_ })
APP_JWT_SECRET=change-me-to-at-least-32-random-characters
APP_JWT_EXPIRATION_MS=86400000

# First admin account, created on startup if it does not exist yet (password: 12+ characters).
ADMIN_EMAIL=admin@placementhub.local
ADMIN_PASSWORD=change-me-admin-password

# Optional: Google Gemini key for the in-app AI guide (https://aistudio.google.com).
GEMINI_API_KEY=
GEMINI_API_MODEL=gemini-3.6-flash

# ---- Frontend ----
# Open the app at http://localhost:<FRONTEND_PORT>
FRONTEND_PORT=3000
